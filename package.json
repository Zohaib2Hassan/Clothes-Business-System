{
  "name": "clothing-business-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/cleanPort.js",
    "clean": "node scripts/cleanPort.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,ML,FRONTEND\" -c \"yellow.bold,green.bold,cyan.bold\" \"nodemon server/server.js\" \"ml\\venv\\Scripts\\python.exe -m uvicorn api.main:app --host 127.0.0.1 --port 8000 --app-dir ml\" \"vite\"",
    "dev:server": "node server/server.js",
    "dev:ml": "ml\\venv\\Scripts\\python.exe -m uvicorn api.main:app --host 127.0.0.1 --port 8000 --app-dir ml",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/server.js",
    "server:dev": "nodemon server/server.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@sfpy/node-core": "^0.3.5",
