# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Safepay Payment Gateway (Sandbox)
SAFEPAY_PUBLIC_KEY=your_safepay_public_key
SAFEPAY_SECRET_KEY=your_safepay_secret_key
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com
SAFEPAY_ENVIRONMENT=sandbox

# Google Gemini AI
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Override the default Gemini model (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Python Machine Learning Microservice
ML_SERVICE_URL=http://127.0.0.1:8000

# Email Service (Optional - for sending real 2FA codes and notification emails)
# If left blank, 2FA codes are displayed directly on the login screen for testing.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_SERVICE=gmail
# Or custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
